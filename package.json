{
  "name": "gitifact",
  "version": "0.1.0",
  "description": "Turn GitHub HTML files into live artifacts. Chrome extension that previews HTML files directly on GitHub.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
